# ---------------------------------------------------------------------------
# Academy LMS configuration template
#
# Copy this file to ".env" and fill in the values for the server it runs on.
# The application reads every setting from here, so no PHP file has to be
# edited when the project moves between machines or owners.
#
# To hand this installation to a new company only three blocks change:
#   1. the DB_* line set (its own database),
#   2. APP_URL and APP_DEBUG (the live address),
#   3. the MAIL_* block plus COMPANY_* names (the sending mailbox, its Google
#      App Password and the inboxes that receive the automated alerts).
# Everything else keeps working as it is.
# ---------------------------------------------------------------------------

# Name displayed by the application.
APP_NAME=TSG Academy LMS
# Runtime environment; use production on the live server.
APP_ENV=local
# Show detailed errors locally; set false in production.
APP_DEBUG=true
# Public base URL of this application, without a trailing slash.
APP_URL=http://localhost/TSG-Academy-LMS
# Timezone used for dates and reports.
APP_TIMEZONE=Asia/Karachi
# Cookie name used for login sessions.
SESSION_NAME=tsg_lms_session

# MySQL/MariaDB server hostname the application connects to.
DB_HOST=127.0.0.1
# MySQL/MariaDB port; 3306 is the XAMPP default.
DB_PORT=3306
# Database name holding the LMS schema.
DB_NAME=tsg_academy_lms
# Database login username.
DB_USER=root
# Database login password; keep private and never commit it.
DB_PASS=

# ---------------------------------------------------------------------------
# Outgoing email. Every automated message (OTP, payment, certificate, student
# and developer alerts) is sent through these settings only, so changing the
# mailbox here redirects all of them at once.
#
# Gmail and Google Workspace require a 16-character Google App Password, not
# the normal account password. Create it at myaccount.google.com/apppasswords.
# ---------------------------------------------------------------------------
# SMTP server hostname.
MAIL_HOST=smtp.gmail.com
# SMTP submission port (587 for STARTTLS, 465 for SSL).
MAIL_PORT=587
# SMTP connection security: tls, ssl or none.
MAIL_ENCRYPTION=tls
# Mailbox that authenticates against the SMTP server. The company sends from
# its own address here, for example No-reply@techsgstudio.com
MAIL_USERNAME=no-reply@techsgstudio.com
# Google App Password for MAIL_USERNAME; remove the spaces, keep it secret.
MAIL_PASSWORD=replace-with-16-character-google-app-password
# Sender email address shown to recipients. Gmail requires this to match
# MAIL_USERNAME; other providers may send on behalf of a different address.
MAIL_FROM_ADDRESS=no-reply@techsgstudio.com
# Sender name recipients see in their inbox.
MAIL_FROM_NAME=TSG Academy
# Address a recipient lands on when they press Reply. Leave it unset and the
# application falls back to MAIL_FROM_ADDRESS.
MAIL_REPLY_TO_ADDRESS=info@techsgstudio.com

# ---------------------------------------------------------------------------
# Internal delivery addresses for the automated alerts. Each one falls back to
# the line above it when it is left blank, so a single mailbox can receive
# everything during testing and be split per department later. You never have to
# repeat the sending address here.
# ---------------------------------------------------------------------------
# Inbox that receives new-student signup alerts and the payment-approval queue;
# this is not an admin login account. Leave blank and the sending mailbox above
# receives them.
MAIL_ADMIN_NOTIFICATION_ADDRESS=hr@techsgstudio.com
# Inbox that receives the developer alerts: new registration with the payment
# request, the approved share, and the monthly revenue summary.
DEVELOPER_NOTIFICATION_MAIL_ADDRESS=developer@techsgstudio.com
# Optional extra inbox for new course-certificate requests. Leave blank to keep
# them in the admin inbox above.
MAIL_CERTIFICATE_REQUEST_ADDRESS=
# Name the developer alerts greet, e.g. "Dear Raza - Ullah Sajid".
MAIL_DEVELOPER_NAME=Raza - Ullah Sajid

# ---------------------------------------------------------------------------
# Company identity printed in the footer of every email. Set once and used by
# all templates, so a rebrand never means editing template code.
# ---------------------------------------------------------------------------
# Short trading name used in greetings and email footers.
COMPANY_NAME=Tech SG Studio
# Full registered legal name shown in the email signature block.
COMPANY_LEGAL_NAME=Tech SG Studio (SMC-Private) Limited
# Public website linked from every email and used to build legal-page URLs.
COMPANY_SITE_URL=https://techsgstudio.com
