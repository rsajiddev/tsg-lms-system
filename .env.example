# Name displayed by the application.
APP_NAME=TSG Academy LMS
# Runtime environment; use production on the live server.
APP_ENV=local
# Show detailed errors locally; set false in production.
APP_DEBUG=true
# Public base URL of this application.
APP_URL=http://localhost/TSG-Academy-LMS
# Timezone used for dates and reports.
APP_TIMEZONE=Asia/Karachi
# Cookie name used for login sessions.
SESSION_NAME=tsg_lms_session

# MySQL/MariaDB connection settings.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tsg_academy_lms
DB_USER=root
DB_PASS=

# Gmail test configuration. For company delivery, replace these with the approved provider.
# Gmail requires a Google App Password (not the normal Gmail account password).
# SMTP server hostname.
MAIL_HOST=smtp.gmail.com
# SMTP submission port (587 for STARTTLS, 465 for SSL).
MAIL_PORT=587
# SMTP connection security: tls or ssl.
MAIL_ENCRYPTION=tls
# Gmail account used to authenticate with the SMTP server.
MAIL_USERNAME=your-address@gmail.com
# Google App Password for MAIL_USERNAME; remove spaces and never commit real credentials.
MAIL_PASSWORD=replace-with-16-character-google-app-password
# Sender email address; Gmail testing should use the same address as MAIL_USERNAME.
MAIL_FROM_ADDRESS=your-address@gmail.com
# Sender name recipients see in their inbox.
MAIL_FROM_NAME=TSG Academy
# Inbox that receives new-student signup alerts; this is not an admin login account.
MAIL_ADMIN_NOTIFICATION_ADDRESS=your-address@gmail.com
# Inbox for the responsible admin/developer to receive payment approval alerts.
# Payment review and its email notification are planned, not implemented yet.
MAIL_PAYMENT_APPROVAL_NOTIFICATION_ADDRESS=your-address@gmail.com
