# Application name shown in the LMS interface.
APP_NAME="TSG Academy LMS"
# Runtime environment; use production on the live server.
APP_ENV=local
# Enable detailed errors locally; disable this in production.
APP_DEBUG=false
# Public base URL of this application.
APP_URL=http://localhost/TSG-Academy-LMS
# Timezone used for application dates and reports.
APP_TIMEZONE=Asia/Karachi

# Database server hostname or IP address.
DB_HOST=127.0.0.1
# Database server port.
DB_PORT=3306
# Database name used by the LMS.
DB_NAME=tsg_academy_lms
# Database login username.
DB_USER=root
# Database login password; keep private.
DB_PASS=
# Cookie name used for login sessions.
SESSION_NAME=tsg_lms_session

# ---------------------------------------------------------------------------
# OUTGOING EMAIL - the block a company has to change.
#
# Put the company mailbox in MAIL_USERNAME and MAIL_FROM_ADDRESS, its 16-digit
# Google App Password in MAIL_PASSWORD, and every automated message (student
# OTP, payment requests and decisions, certificate alerts) starts coming from
# that address; company-side alerts (HR and certificate) are delivered into it.
# Developer alerts are NOT mixed in - they go to the separate MAIL_DEVELOPER_ADDRESS
# below, so the developer never receives company mail and vice versa.
# ---------------------------------------------------------------------------

# SMTP server hostname.
MAIL_HOST=smtp.gmail.com
# SMTP port (587 for STARTTLS, 465 for SSL).
MAIL_PORT=587
# SMTP transport security: tls or ssl.
MAIL_ENCRYPTION=tls
# Sender name shown in the recipient's inbox.
MAIL_FROM_NAME=Your Company
# Email account used to authenticate with SMTP.
# USE CASE (Roman Urdu): Yeh account sirf SMTP server (smtp.gmail.com) ko LOGIN
# karwane ke liye hai - background authentication. Recipients ko yeh address
# nahi dikhta. Isme wahi mailbox daalein jiska App Password neeche hai.
MAIL_USERNAME=no-reply@example.com
# SMTP App Password (Google 16-character app password, spaces removed); keep secret.
# USE CASE (Roman Urdu): Gmail normal password accept nahi karta - yeh Google ka
# 16-character App Password hai (myaccount.google.com/apppasswords se banta hai,
# spaces hata kar). Iske bagair koi email nahi jayegi.
MAIL_PASSWORD=your-google-app-password

# THE COMPANY SENDING ADDRESS. This mailbox is the "from" address of every
# automated email the platform sends and the inbox that receives the company's
# own alerts - HR registration and payment notices, certificate requests. It
# does NOT receive developer copies; those follow MAIL_DEVELOPER_ADDRESS below.
# USE CASE (Roman Urdu): Yeh address recipients ke inbox me "From" ke tor par
# DIKHTA hai, aur HR/certificate ki internal alerts isi par aati hain. Developer
# ki notifications yahan NAHI aatin - wo neeche alag address par jati hain. Gmail
# par yeh MAIL_USERNAME se match karna chahiye; company handover me MAIL_USERNAME,
# MAIL_PASSWORD aur yeh address badal dein - bas itna hi kaam hai.
MAIL_FROM_ADDRESS=no-reply@example.com
# Reply-to address. Blank = replies go to MAIL_FROM_ADDRESS.
MAIL_REPLY_TO_ADDRESS=

# DEVELOPER INBOX - kept separate from the company on purpose. Every developer
# copy (registration, payment submitted, payment approved, monthly revenue report)
# is delivered here and never to MAIL_FROM_ADDRESS. Leave it blank and the
# developer copies fall back to the company mailbox, but a live installation
# should always set a real, distinct developer address.
# USE CASE (Roman Urdu): Developer ki SAARI notifications sirf yahan jaati hain -
# company ki email par bilkul nahi. Ise alag developer Gmail rakhein.
MAIL_DEVELOPER_NAME=Raza - Ullah Sajid
MAIL_DEVELOPER_ADDRESS=rsajiddev@gmail.com
# Developer revenue-share percentage used in every payment email, the monthly
# report and the Revenue & Payments page. Change one number here (e.g. 18) and
# every calculation and label follows; blank or invalid falls back to 15.
DEVELOPER_SHARE_PERCENT=15

# ---------------------------------------------------------------------------
# Company identity printed in every email footer and legal link.
# ---------------------------------------------------------------------------
# Short trading name used in greetings.
COMPANY_NAME=Your Company
# Full registered legal name shown in the signature block.
COMPANY_LEGAL_NAME=Your Company (SMC-Private) Limited
# Public website linked from every automated email.
COMPANY_SITE_URL=https://example.com
